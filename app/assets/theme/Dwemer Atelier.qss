/*!*************************************
  Dwemer Atelier
****************************************
  Dark theme for Mod Organizer 2.5 (Qt 6.5): graphite surfaces, brass accent, cream text.
  Generated by build_theme.py - edit TOKENS there, not this file.
  Colours that MO2 paints itself (conflict highlights, separators) live in
  Settings > Theme > Colors and are not touched here.
****************************************/

* {
  outline: 0;
}

QWidget {
  background-color: #1D2128;
  color: #E4E1D9;
  font-family: "Atelier UI", "Segoe UI Variable Text", "Segoe UI";
  selection-background-color: #4A4232;
  selection-color: #F4F1EA;
}

QWidget:disabled {
  color: #5C6370;
}

QLabel,
QCheckBox,
QRadioButton,
QToolBar QLabel {
  background-color: transparent;
}

LinkLabel {
  qproperty-linkColor: #D6AC62;
}

/* ---------- main window chrome ---------- */

QMainWindow::separator {
  background: #1D2128;
  width: 6px;
  height: 6px;
}

QMainWindow::separator:hover,
QSplitter::handle:hover {
  background: #3F4655;
}

QSplitter::handle {
  background: #1D2128;
}

QSplitter::handle:horizontal {
  width: 6px;
}

QSplitter::handle:vertical {
  height: 6px;
}

QMenuBar {
  background-color: #1D2128;
  border-bottom: 1px solid #2E343E;
  padding: 2px 4px;
}

QMenuBar::item {
  background: transparent;
  padding: 4px 10px;
  border-radius: 4px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
  background-color: #2C313B;
  color: #F4F1EA;
}

QToolBar {
  background-color: #1D2128;
  border: none;
  border-bottom: 1px solid #2E343E;
  padding: 4px 6px;
  spacing: 2px;
}

QToolBar::separator {
  background-color: #3F4655;
  width: 1px;
  margin: 8px 7px;
}

QToolBar::handle {
  width: 0;
}

QToolButton {
  background-color: transparent;
  border: 1px solid transparent;
  border-radius: 6px;
  padding: 4px;
  color: #9AA1AE;
}

QToolButton:hover {
  background-color: rgba(255, 255, 255, 0.06);
  color: #E4E1D9;
}

QToolButton:pressed,
QToolButton:checked {
  background-color: rgba(214, 172, 98, 0.18);
  border-color: rgba(214, 172, 98, 0.35);
  color: #F4F1EA;
}

QToolButton:disabled {
  background-color: transparent;
}

QToolButton[popupMode="1"],
QToolButton[popupMode="MenuButtonPopup"] {
  padding-right: 14px;
}

QToolButton::menu-indicator {
  image: url("./Dwemer Atelier/chevron-down.svg");
  width: 9px;
  height: 9px;
  subcontrol-origin: padding;
  subcontrol-position: bottom right;
  right: 2px;
  bottom: 2px;
}

QToolButton::menu-button {
  border: none;
  width: 14px;
}

QToolButton::menu-arrow {
  image: url("./Dwemer Atelier/chevron-down.svg");
  width: 9px;
  height: 9px;
}

QStatusBar {
  background-color: #1D2128;
  border-top: 1px solid #2E343E;
  color: #9AA1AE;
}

QStatusBar::item {
  border: none;
}

QStatusBar QLabel {
  color: #9AA1AE;
  padding: 0 4px;
}

QDockWidget {
  color: #9AA1AE;
  titlebar-close-icon: url("./Dwemer Atelier/close.svg");
  titlebar-normal-icon: url("./Dwemer Atelier/float.svg");
}

QDockWidget::title {
  background-color: #232830;
  border-top: 1px solid #2E343E;
  border-bottom: 1px solid #2E343E;
  padding: 5px 8px;
  text-align: left;
}

QDockWidget::close-button,
QDockWidget::float-button {
  background: transparent;
  border: none;
  border-radius: 4px;
  padding: 1px;
  icon-size: 12px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
  background: rgba(255, 255, 255, 0.08);
}

/* ---------- item views ---------- */

QAbstractItemView,
QTreeView,
QListView,
QTableView {
  background-color: #171A20;
  alternate-background-color: #1A1D24;
  color: #E4E1D9;
  border: 1px solid #2E343E;
  outline: 0;
  show-decoration-selected: 1;
  selection-background-color: #4A4232;
  selection-color: #F4F1EA;
}

QAbstractItemView:focus {
  border-color: #3F4655;
}

/* no ::item background: MO2 paints conflict and separator colours through it */
QAbstractItemView::item:hover,
QTreeView::branch:hover {
  background-color: rgba(255, 255, 255, 0.045);
}

QAbstractItemView::item:selected,
QAbstractItemView::item:selected:hover,
QTreeView::branch:selected {
  background-color: #4A4232;
  color: #F4F1EA;
}

QAbstractItemView::item:selected:!active,
QTreeView::branch:selected:!active {
  background-color: #2B303A;
  color: #E4E1D9;
}

QAbstractItemView::item:disabled,
QAbstractItemView::item:selected:disabled {
  color: #5C6370;
}

/* comfortable 26 px rows in the big lists; vertical padding only */
ModListView::item,
PluginListView::item,
QTreeView#dataTree::item,
QTreeWidget#savegameList::item,
MOBase--SortableTreeWidget::item,
QTreeWidget#filters::item {
  padding: 4px 0;
}

/* Qt lays out a checkable cell differently once a hover/selected rule paints it, which
   pushed the name ~3 px right; pull the first column back so rows do not jump */
ModListView::item:hover:first,
ModListView::item:selected:first,
PluginListView::item:hover:first,
PluginListView::item:selected:first,
MOBase--SortableTreeWidget::item:hover:first,
MOBase--SortableTreeWidget::item:selected:first,
ModListView::item:focus:first,
PluginListView::item:focus:first,
MOBase--SortableTreeWidget::item:focus:first {
  margin-left: -3px;
}

/* drop the dotted native focus rectangle on the current row */
QAbstractItemView::item:focus {
  border: 0px solid transparent;
}

LogList::item {
  padding: 1px 2px;
}

QTreeView::branch {
  background: transparent;
}

QTreeView::branch:closed:has-children {
  image: url("./Dwemer Atelier/chevron-right.svg");
}

QTreeView::branch:open:has-children {
  image: url("./Dwemer Atelier/chevron-down.svg");
}

QTreeView::branch:closed:has-children:hover {
  image: url("./Dwemer Atelier/chevron-right-hover.svg");
}

QTreeView::branch:open:has-children:hover {
  image: url("./Dwemer Atelier/chevron-down-hover.svg");
}

QTableView {
  gridline-color: #2E343E;
}

QTableView QTableCornerButton::section {
  background-color: #232830;
  border: none;
  border-right: 1px solid #2E343E;
  border-bottom: 1px solid #2E343E;
}

QHeaderView {
  background-color: #232830;
  border: none;
}

QHeaderView::section {
  background-color: #232830;
  color: #9AA1AE;
  padding: 5px 8px;
  border: none;
  border-right: 1px solid #2E343E;
  border-bottom: 1px solid #2E343E;
}

QHeaderView::section:hover {
  background-color: #2C313B;
  color: #E4E1D9;
}

QHeaderView::section:checked {
  color: #E4E1D9;
}

QHeaderView::section:last {
  border-right: none;
}

QHeaderView::up-arrow,
QHeaderView::down-arrow {
  subcontrol-origin: padding;
  subcontrol-position: center right;
  width: 10px;
  height: 10px;
  right: 4px;
}

QHeaderView::up-arrow {
  image: url("./Dwemer Atelier/sort-asc.svg");
}

QHeaderView::down-arrow {
  image: url("./Dwemer Atelier/sort-desc.svg");
}

/* ---------- scroll bars: slim, no arrows ---------- */

QAbstractScrollArea::corner {
  background-color: transparent;
  border: none;
}

QScrollBar {
  background-color: transparent;
  border: none;
}

QScrollBar:vertical {
  width: 12px;
  margin: 0;
}

QScrollBar:horizontal {
  height: 12px;
  margin: 0;
}

QScrollBar::handle {
  background-color: rgba(228, 225, 217, 0.16);
  border-radius: 3px;
}

QScrollBar::handle:vertical {
  min-height: 36px;
  margin: 3px 3px;
}

QScrollBar::handle:horizontal {
  min-width: 36px;
  margin: 3px 3px;
}

QScrollBar::handle:hover {
  background-color: rgba(228, 225, 217, 0.30);
}

QScrollBar::handle:pressed {
  background-color: rgba(214, 172, 98, 0.65);
}

QScrollBar::add-line,
QScrollBar::sub-line {
  background: none;
  border: none;
  width: 0;
  height: 0;
}

QScrollBar::add-page,
QScrollBar::sub-page {
  background: transparent;
}

/* ---------- menus and tooltips ---------- */

QMenu {
  background-color: #272C35;
  border: 1px solid #3F4655;
  padding: 4px;
}

QMenu::item {
  background-color: transparent;
  padding: 5px 28px 5px 12px;
  border-radius: 4px;
  margin: 1px 0;
}

QMenu::item:selected {
  background-color: #4A4232;
  color: #F4F1EA;
}

QMenu::item:disabled {
  background-color: transparent;
  color: #5C6370;
}

QMenu::separator {
  background-color: #3F4655;
  height: 1px;
  margin: 4px 8px;
}

QMenu::icon {
  padding-left: 6px;
}

QMenu::indicator {
  width: 14px;
  height: 14px;
  padding-left: 6px;
}

QMenu::indicator:checked {
  image: url("./Dwemer Atelier/check-menu.svg");
}

QMenu::right-arrow {
  image: url("./Dwemer Atelier/chevron-right.svg");
  width: 12px;
  height: 12px;
  padding-right: 6px;
}

QMenu::right-arrow:selected {
  image: url("./Dwemer Atelier/chevron-right-hover.svg");
}

QMenu QCheckBox,
QMenu QRadioButton,
QMenu QPushButton {
  background-color: transparent;
  padding: 4px 6px;
}

QToolTip,
GamebryoSaveGameInfoWidget {
  background-color: #272C35;
  color: #E4E1D9;
  border: 1px solid #3F4655;
  padding: 4px 8px;
}

/* ---------- inputs ---------- */

QLineEdit,
QAbstractSpinBox,
QTextEdit,
QPlainTextEdit,
QComboBox {
  background-color: #171A20;
  border: 1px solid #3F4655;
  border-radius: 4px;
  selection-background-color: rgba(214, 172, 98, 0.45);
  selection-color: #F4F1EA;
}

QLineEdit,
QAbstractSpinBox {
  padding: 4px 6px;
  min-height: 16px;
}

QTextEdit,
QPlainTextEdit {
  padding: 2px;
}

QLineEdit:hover,
QAbstractSpinBox:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QComboBox:hover {
  border-color: #566073;
}

QLineEdit:focus,
QAbstractSpinBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QComboBox:on {
  border-color: #D6AC62;
}

QLineEdit:disabled,
QAbstractSpinBox:disabled,
QTextEdit:disabled,
QComboBox:disabled {
  background-color: #232830;
  border-color: #2E343E;
}

QLineEdit[valid-filter=false] {
  background-color: #2C1C1F;
  border-color: #E0645C;
}

QLineEdit QToolButton,
QLineEdit QToolButton:hover {
  background: transparent;
  border: none;
  padding: 0;
}

QComboBox {
  padding: 3px 8px;
  min-height: 20px;
}

QComboBox:editable {
  background-color: #171A20;
}

QComboBox::drop-down {
  subcontrol-origin: padding;
  subcontrol-position: center right;
  width: 22px;
  border: none;
}

QComboBox::down-arrow {
  image: url("./Dwemer Atelier/chevron-down.svg");
  width: 11px;
  height: 11px;
}

QComboBox::down-arrow:hover,
QComboBox::down-arrow:on {
  image: url("./Dwemer Atelier/chevron-down-hover.svg");
}

QComboBox::down-arrow:disabled {
  image: url("./Dwemer Atelier/chevron-down-disabled.svg");
}

QComboBox QAbstractItemView {
  background-color: #272C35;
  border: 1px solid #3F4655;
  padding: 4px;
  selection-background-color: #4A4232;
  selection-color: #F4F1EA;
}

QAbstractSpinBox {
  padding-right: 20px;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
  subcontrol-origin: border;
  width: 18px;
  border: none;
  border-left: 1px solid #2E343E;
  background-color: transparent;
}

QAbstractSpinBox::up-button {
  subcontrol-position: top right;
  border-top-right-radius: 4px;
}

QAbstractSpinBox::down-button {
  subcontrol-position: bottom right;
  border-bottom-right-radius: 4px;
}

QAbstractSpinBox::up-button:hover,
QAbstractSpinBox::down-button:hover {
  background-color: rgba(255, 255, 255, 0.06);
}

QAbstractSpinBox::up-arrow {
  image: url("./Dwemer Atelier/chevron-up.svg");
  width: 9px;
  height: 9px;
}

QAbstractSpinBox::down-arrow {
  image: url("./Dwemer Atelier/chevron-down.svg");
  width: 9px;
  height: 9px;
}

/* ---------- buttons ---------- */

QPushButton {
  background-color: #2C313B;
  border: 1px solid #3F4655;
  border-radius: 4px;
  padding: 4px 12px;
  min-height: 18px;
  color: #E4E1D9;
}

QPushButton:hover {
  background-color: #353B47;
  border-color: #566073;
  color: #F4F1EA;
}

QPushButton:pressed {
  background-color: #232830;
}

QPushButton:focus {
  border-color: #D6AC62;
}

QPushButton:checked {
  background-color: rgba(214, 172, 98, 0.18);
  border-color: #D6AC62;
  color: #E8C27E;
}

QPushButton:disabled {
  background-color: #232830;
  border-color: #2E343E;
  color: #5C6370;
}

QPushButton::menu-indicator {
  image: url("./Dwemer Atelier/chevron-down.svg");
  subcontrol-origin: padding;
  subcontrol-position: center right;
  width: 9px;
  height: 9px;
  right: 2px;
}

QDialogButtonBox QPushButton {
  min-width: 72px;
}

/* the dialog's default action (OK, Install, ...) */
QDialog QPushButton:default {
  background-color: #C39448;
  border-color: #D6AC62;
  color: #1C140A;
}

QDialog QPushButton:default:hover {
  background-color: #D9AE63;
}

QDialog QPushButton:default:disabled {
  background-color: #232830;
  border-color: #2E343E;
  color: #5C6370;
}

/* Run - the one primary button of the main window */
QPushButton#startButton {
  background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #D9AE63, stop: 1 #C39448);
  border: 1px solid #D6AC62;
  border-radius: 6px;
  color: #1C140A;
  font-weight: 600;
  padding: 6px 14px;
}

QPushButton#startButton:hover {
  background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #E8C27E, stop: 1 #D9AE63);
}

QPushButton#startButton:pressed {
  background-color: #C39448;
}

QPushButton#startButton:disabled {
  background-color: #232830;
  border-color: #2E343E;
  color: #5C6370;
}

QPushButton#linkButton {
  border-radius: 6px;
}

QFrame#startGroup {
  background-color: transparent;
}

/* ---------- check boxes and radio buttons ---------- */

QCheckBox,
QRadioButton {
  spacing: 7px;
}

QCheckBox::indicator,
QGroupBox::indicator,
QTreeView::indicator,
QListView::indicator,
QTableView::indicator {
  width: 14px;
  height: 14px;
  background-color: #171A20;
  border: 1px solid #5A6274;
  border-radius: 3px;
}

QCheckBox::indicator:hover,
QGroupBox::indicator:hover,
QTreeView::indicator:hover,
QListView::indicator:hover,
QTableView::indicator:hover {
  border-color: #D6AC62;
}

QCheckBox::indicator:checked,
QGroupBox::indicator:checked,
QTreeView::indicator:checked,
QListView::indicator:checked,
QTableView::indicator:checked {
  background-color: #C39448;
  border-color: #D6AC62;
  image: url("./Dwemer Atelier/check.svg");
}

QCheckBox::indicator:indeterminate,
QTreeView::indicator:indeterminate {
  background-color: #C39448;
  border-color: #D6AC62;
  image: url("./Dwemer Atelier/dash.svg");
}

QCheckBox::indicator:disabled,
QGroupBox::indicator:disabled,
QTreeView::indicator:disabled,
QListView::indicator:disabled,
QTableView::indicator:disabled {
  background-color: #232830;
  border-color: #2E343E;
}

QCheckBox::indicator:checked:disabled,
QGroupBox::indicator:checked:disabled,
QTreeView::indicator:checked:disabled,
QListView::indicator:checked:disabled,
QTableView::indicator:checked:disabled {
  background-color: #2C313B;
  image: url("./Dwemer Atelier/check-disabled.svg");
}

QRadioButton::indicator {
  width: 14px;
  height: 14px;
  background-color: #171A20;
  border: 1px solid #5A6274;
  border-radius: 7px;
}

QRadioButton::indicator:hover {
  border-color: #D6AC62;
}

QRadioButton::indicator:checked {
  border: none;
  background-color: transparent;
  image: url("./Dwemer Atelier/radio-on.svg");
}

QRadioButton::indicator:checked:disabled {
  image: url("./Dwemer Atelier/radio-on-disabled.svg");
}

QRadioButton::indicator:disabled {
  background-color: #232830;
  border-color: #2E343E;
}

/* ---------- containers ---------- */

QGroupBox {
  background-color: transparent;
  border: 1px solid #2E343E;
  border-radius: 6px;
  margin-top: 1.5em;
  padding: 6px;
}

QGroupBox::title {
  subcontrol-origin: margin;
  subcontrol-position: top left;
  left: 2px;
  bottom: 3px;
  padding: 0 4px;
  color: #9AA1AE;
  font-weight: 600;
  background-color: transparent;
}

QTabWidget::pane {
  background-color: #1D2128;
  border: 1px solid #2E343E;
  top: -1px;
}

QTabBar {
  background: transparent;
  qproperty-drawBase: 0;
}

QTabBar::tab {
  background-color: transparent;
  color: #9AA1AE;
  padding: 7px 14px 6px 14px;
  border: none;
  border-bottom: 2px solid transparent;
  margin-right: 2px;
}

QTabBar::tab:hover {
  background-color: rgba(255, 255, 255, 0.04);
  color: #E4E1D9;
}

QTabBar::tab:selected {
  color: #F4F1EA;
  border-bottom-color: #D6AC62;
}

QTabBar::tab:disabled {
  color: #5C6370;
}

QTabBar QToolButton {
  background-color: #2C313B;
  border: 1px solid #2E343E;
  border-radius: 4px;
  padding: 1px;
}

QTabBar QToolButton::right-arrow {
  image: url("./Dwemer Atelier/chevron-right.svg");
}

QTabBar QToolButton::left-arrow {
  image: url("./Dwemer Atelier/chevron-left.svg");
}

QScrollArea,
QStackedWidget {
  background-color: transparent;
}

QFrame[frameShape="4"],
QFrame[frameShape="5"] {
  background-color: #2E343E;
  border: none;
  max-height: 1px;
}

QFrame[frameShape="5"] {
  max-height: 16777215px;
  max-width: 1px;
}

/* ---------- counters, progress, sliders ---------- */

QLCDNumber {
  background-color: transparent;
  color: #D6AC62;
  border: none;
  qproperty-segmentStyle: Flat;
}

QProgressBar {
  background-color: #171A20;
  border: 1px solid #2E343E;
  border-radius: 4px;
  color: #E4E1D9;
  text-align: center;
  min-height: 14px;
}

QProgressBar::chunk {
  background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #C39448, stop: 1 #D9AE63);
  border-radius: 3px;
}

QSlider::groove:horizontal {
  background-color: #2C313B;
  height: 4px;
  border-radius: 2px;
}

QSlider::sub-page:horizontal {
  background-color: #C39448;
  border-radius: 2px;
}

QSlider::handle:horizontal {
  background-color: #E4E1D9;
  border: 2px solid #D6AC62;
  width: 12px;
  height: 12px;
  margin: -6px 0;
  border-radius: 8px;
}

QSlider::groove:vertical {
  background-color: #2C313B;
  width: 4px;
  border-radius: 2px;
}

QSlider::handle:vertical {
  background-color: #E4E1D9;
  border: 2px solid #D6AC62;
  width: 12px;
  height: 12px;
  margin: 0 -6px;
  border-radius: 8px;
}

/* ---------- MO2 specifics ---------- */

/* text editors in the mod info dialog */
TextEditor {
  qproperty-textColor: #E4E1D9;
  qproperty-backgroundColor: #171A20;
  qproperty-highlightBackgroundColor: #232830;
}

TextEditorLineNumbers {
  qproperty-textColor: #5C6370;
  qproperty-backgroundColor: #1D2128;
}

/* unchecked archives stand out */
QWidget#bsaTab QTreeWidget::indicator:unchecked {
  border-color: #D6AC62;
}

QWidget#tabImages QPushButton {
  background-color: transparent;
  border: none;
  margin: 0 0.3em;
  padding: 0;
}

QDialog#QueryOverwriteDialog QPushButton {
  margin-left: 0.5em;
}

QDialog#QueryOverwriteDialog {
  min-width: 565px;
}

QDialog#ModInfoDialog {
  min-width: 850px;
}

QLineEdit#versionEdit {
  max-width: 100px;
}

QProgressBar[downloadProgress=true] {
  background-color: #232830;
}

/* ---------- toolbar icons ---------- */

QToolButton#actionChange_Game {
  qproperty-icon: url("./Dwemer Atelier/toolbar/actionChange_Game.png");
}

QToolButton#actionInstallMod {
  qproperty-icon: url("./Dwemer Atelier/toolbar/actionInstallMod.png");
}

QToolButton#actionNexus {
  qproperty-icon: url("./Dwemer Atelier/toolbar/actionNexus.png");
}

QToolButton#actionModPage {
  qproperty-icon: url("./Dwemer Atelier/toolbar/actionModPage.png");
}

QToolButton#actionAdd_Profile {
  qproperty-icon: url("./Dwemer Atelier/toolbar/actionAdd_Profile.png");
}

QToolButton#action_Refresh {
  qproperty-icon: url("./Dwemer Atelier/toolbar/action_Refresh.png");
}

QToolButton#actionModify_Executables {
  qproperty-icon: url("./Dwemer Atelier/toolbar/actionModify_Executables.png");
}

QToolButton#actionTool {
  qproperty-icon: url("./Dwemer Atelier/toolbar/actionTool.png");
}

QToolButton#actionSettings {
  qproperty-icon: url("./Dwemer Atelier/toolbar/actionSettings.png");
}

